[Unit]
Description=Amarin Employee Database
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/amarin-employee
ExecStart=/opt/amarin-employee/venv/bin/gunicorn app:app \
    --bind 127.0.0.1:5100 \
    --workers 3 \
    --timeout 300 \
    --log-level info \
    --access-logfile /var/log/amarin-employee/access.log \
    --error-logfile  /var/log/amarin-employee/error.log \
    --preload
Restart=always
RestartSec=5

# ไม่ให้ process เข้าถึง network ภายนอกเกินจำเป็น
PrivateTmp=true

[Install]
WantedBy=multi-user.target
