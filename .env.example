# คัดลอกเป็น .env แล้วใส่ค่าจริง — .env อยู่ใน .gitignore ห้าม commit
# บัญชีที่ใช้ล็อกอินระบบ eDevice (amarin.intra)
EDEVICE_USER=
EDEVICE_PASS=

# Apps Script endpoint สำหรับเขียนข้อมูลกลับ Google Sheets (ปุ่ม "อัพเดท Sheets")
SHEETS_SCRIPT_URL=

# token ในลิงก์หน้าแรกของ eDevice (default.asp?ID_Emp=...&Right=...)
EDEVICE_INIT_PATH=

# Google Sheet ข้อมูลสัญญาเช่า (ว่าง = ไม่ดึงจาก Sheets)
SHEETS_ID=
